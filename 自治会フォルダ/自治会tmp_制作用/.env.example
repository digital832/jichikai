# ローカルで動作確認する時だけ使うポート番号（Cloud Runにデプロイした際はCloud Runが自動設定するので気にしなくてOK）
PORT=3000

# 名簿一覧などの画面に表示する自治会の名前
COMMUNITY_NAME=

# スプレッドシートのURLの中の長い英数字部分
GOOGLE_SHEETS_SPREADSHEET_ID=1WqfENB2do5y7yIem8a6ozDqS_wuVp5waOSTLS-tKOsw
# 名簿を書いているタブの名前
GOOGLE_SHEETS_SHEET_NAME=名簿
# イベントを書いているタブの名前
GOOGLE_SHEETS_EVENTS_SHEET_NAME=Events
# 定型文（メッセージのひな形）を書いているタブの名前（A列に本文を1行ずつ）
GOOGLE_SHEETS_TEMPLATES_SHEET_NAME=定型文マスタ
# 場所（配信画面の「場所」の選択肢）を書いているタブの名前（A列に場所名を1行ずつ）
GOOGLE_SHEETS_PLACES_SHEET_NAME=場所マスタ
# 対象グループの班名一覧を書いているタブの名前
GOOGLE_SHEETS_GROUP_MASTER_SHEET_NAME=グループマスタ
# 管理地区フォルダ（班ごとのスプレッドシートが入っているDriveフォルダ）のID
GOOGLE_DRIVE_DISTRICT_FOLDER_ID=1ObMwS7yN_gsh1aPmwZkPlYDnuGJRiIkN

# ダウンロードしたJSONファイルを開くと "client_email" というキーがあります。その値をそのまま貼ってください
GOOGLE_SA_CLIENT_EMAIL=id-533@jichikai-tmp.iam.gserviceaccount.com
# 同じJSONファイルの "private_key" の値だけを（-----BEGIN PRIVATE KEY----- から -----END PRIVATE KEY-----\n まで）ダブルクォートで囲んで貼ってください
GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nここにJSONファイルのprivate_keyの値をそのまま貼る\n-----END PRIVATE KEY-----\n"

# （任意・後で設定可）印刷用Google DriveフォルダのURL
PRINT_FOLDER_URL=

# 議事録の自動作成機能で使うGemini APIキー（Google AI Studio [https://aistudio.google.com] で無料発行）
GEMINI_API_KEY=
# 議事録作成に使うGeminiのモデル名（未設定ならgemini-3.6-flash）
GEMINI_MODEL=
# 文字起こし専用のモデル名（未設定ならgemini-3.5-transcribe）
GEMINI_TRANSCRIBE_MODEL=

# 議事録（PDF）を自動保存するDriveフォルダのID（自分のGoogleアカウント上のフォルダでOK）
MINUTES_DRIVE_FOLDER_ID=
# 議事録の一覧・編集用データを書いているタブの名前
GOOGLE_SHEETS_MINUTES_SHEET_NAME=議事録

# 議事録PDFを自分のGoogleアカウント名義で保存するためのOAuth設定
# Cloud Console(APIs & Services > 認証情報)で「デスクトップアプリ」のOAuthクライアントIDを作成し、
# 表示されたクライアントID・シークレットをここに貼ってください
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# ↓ここは貼らなくてOK。scripts/drive-oauth-setup.js を実行すると自動で追記されます
GOOGLE_OAUTH_REFRESH_TOKEN=

# 防災設定を書いているタブの名前
GOOGLE_SHEETS_DISASTER_SHEET_NAME=防災設定

# 決算書（Excel）を自動保存するDriveフォルダのID（自分のGoogleアカウント上のフォルダでOK。議事録と同じOAuth設定を流用します）
# 「決算書」フォルダ自体（テンプレート・データ格納用）ではなく、その親フォルダ（例：会計フォルダ）のIDを指定する。
# 決算書を新規作成すると、この直下に年度名（例：2026年度）のフォルダが自動で作られ、そこにExcelが保存される。
ACCOUNTING_DRIVE_FOLDER_ID=
# 決算書の一覧・編集用データを書いているタブの名前
GOOGLE_SHEETS_STATEMENTS_SHEET_NAME=決算書
# 決算書作成時に入力した予算額を年度ごとに保存しておくタブの名前（次回作成時に前回値を呼び出すため）
GOOGLE_SHEETS_BUDGETS_SHEET_NAME=予算マスタ
# 入出金・決算書で使う科目（収入・支出の項目）を書いているタブの名前。管理画面から追加・編集・削除できる
# （新しく作る場合は、A1に見出し行「科目名/区分/グループ」を入れておくとわかりやすい。データはA2から）
GOOGLE_SHEETS_CATEGORIES_SHEET_NAME=科目マスタ

# 住民用・役員班長用QRコード（PDF）が入っているDriveフォルダのID。
# このフォルダを、GOOGLE_SA_CLIENT_EMAILのサービスアカウント宛に「閲覧者」で共有しておくこと
# （管理地区フォルダと同じく、フォルダ単位の個別共有が必要）
QR_CODE_DRIVE_FOLDER_ID=

# 予約配信（あらかじめ日時を指定して自動でLINE配信する機能）を書いているタブの名前
GOOGLE_SHEETS_SCHEDULE_SHEET_NAME=予約配信
# 予約配信で出欠・安否確認リンクを組み立てるために使う、このアプリが公開されているURL（末尾に/は不要）
# 例: https://jichikai.example.com
BASE_URL=
# 予約配信の送信予定を確認する間隔（ミリ秒）。未設定なら60000（1分）
SCHEDULE_CHECK_INTERVAL_MS=60000

# 注: LINEのChannel Access Tokenはここでは設定しません。
# 班ごとに別々のLINE公式アカウントを使っているため、各会員のトークンは
# 名簿シートのアクセストークン列（会員ごとの行）から読み取ります。

# 管理画面（/admin/以下）のログイン番号（6桁の数字）。未設定の場合はログイン機能自体が無効になり、
# 誰でも管理画面に入れてしまうので必ず設定すること。
ADMIN_PASSCODE=
